#version 450
// Original Altiro experiment. No Arm Compute Library kernel code is included.
// Half bits are rearranged, never requantized: [M,K] -> [ceil(M/4),K,4].
layout(local_size_x=64) in;
layout(binding=0,std430) readonly buffer Input { uint input_data[]; };
layout(binding=1,std430) writeonly buffer Output { uint output_data[]; };
layout(push_constant) uniform Shape { uint m; uint n; uint k; } p;
uint half_at(uint row,uint kk) {
    if(row>=p.m) return 0;
    uint i=row*p.k+kk;
    uint v=input_data[i/2];
    return (v>>((i%2)*16))&65535u;
}
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=((p.m+3)/4)*p.k*2) return;
    uint pair=i%2, kk=(i/2)%p.k, row=(i/(2*p.k))*4+pair*2;
    output_data[i]=half_at(row,kk)|(half_at(row+1,kk)<<16);
}
