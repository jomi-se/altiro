#version 450
// Lossless reordering of already-half-rounded F32 values.
layout(local_size_x=64) in;
layout(binding=0,std430) readonly buffer Input { float input_data[]; };
layout(binding=1,std430) writeonly buffer Output { vec4 output_data[]; };
layout(push_constant) uniform Shape { uint m; uint n; uint k; } p;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=((p.n+3)/4)*p.k) return;
    uint col=(i/p.k)*4, kk=i%p.k;
    vec4 v=vec4(0);
    for(uint j=0;j<4;j++) if(col+j<p.n) v[j]=input_data[(col+j)*p.k+kk];
    output_data[i]=v;
}
